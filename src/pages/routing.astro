---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';
import Frame from '../components/Frame.astro';
import { assetSize, assetUrl, sourceDir } from '../lib/source';

/* The README's section, then the longer document it points to, with the
 * routing panel between them. */
const release = (await getEntry('release', 'current'))!.data;
const readme = (await getEntry('docs', 'routing'))!;
const doc = (await getEntry('docs', 'routing-doc'))!;
const first = await render(readme);
const second = await render(doc);
const headings = [
  ...first.headings.filter((h) => h.depth === 1).map((h) => ({ ...h, depth: 2 })),
  ...second.headings.filter((h) => h.depth === 1).map((h) => ({ ...h, depth: 2 })),
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dir = sourceDir();
const file = 'docs/assets/routing.png';
const panel = release.gallery.find((g) => g.file === file)!;
---
<Base title="Routing" path="routing/" page="routing" description={readme.data.description}>
  <div class="with-rail shell" data-copy>
    <Contents headings={headings} depth={2} label="Sections" />
    <div class="stack">
      <article class="prose"><first.Content /></article>
      <Frame src={assetUrl(base, file)} alt={panel.alt} {...assetSize(dir, file)} label={panel.key} caption={`${panel.blurb} ${release.provenance}`} />
      <article class="prose"><second.Content /></article>
    </div>
  </div>
</Base>
