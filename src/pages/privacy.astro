---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';

const entry = (await getEntry('docs', 'privacy'))!;
const { Content, headings } = await render(entry);
---
<Base title="Privacy" path="privacy/" page="privacy" description={entry.data.description}>
  <div class="with-rail shell">
    <Contents headings={headings} depth={2} />
    <article class="prose"><Content /></article>
  </div>
</Base>
