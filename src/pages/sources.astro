---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';

const entry = (await getEntry('docs', 'sources'))!;
const { Content, headings } = await render(entry);
---
<Base title="Data sources" path="sources/" page="sources" description={entry.data.description}>
  <div class="with-rail shell" data-copy>
    <Contents headings={headings} depth={2} label="Sources" />
    <article class="prose"><Content /></article>
  </div>
</Base>
