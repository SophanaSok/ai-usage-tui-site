---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Not found" path="404/" page="404" index={false}>
  <div class="shell">
    <section class="hero">
      <div class="hero-title">
        <p class="eyebrow">404</p>
        <h1>Not found</h1>
      </div>
      <p class="lede">There is no page here. <a href={`${base}/`}>Back to the dashboard.</a></p>
    </section>
  </div>
</Base>
